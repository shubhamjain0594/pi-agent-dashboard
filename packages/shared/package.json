{
  "name": "@blackbelt-technology/pi-dashboard-shared",
  "version": "0.9.0",
  "description": "Shared types and utilities for pi-dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pi-dashboard-ensure": "bin/pi-dashboard-ensure.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./*.mjs": "./src/*.mjs",
    "./*.js": "./src/*.ts",
    "./*": "./src/*",
    "./dashboard-plugin/*.js": "./src/dashboard-plugin/*.ts",
    "./dashboard-plugin/*": "./src/dashboard-plugin/*"
  },
  "files": [
    "src/",
    "!**/test-support",
    "bin/",
    "!**/AGENTS.md",
    "!**/*.AGENTS.md",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx"
  ],
  "dependencies": {
    "amaro": "1.2.1",
    "bonjour-service": "^1.3.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/semver": "^7.7.0",
    "jose": "^6.2.12",
    "memfs": "^4.80.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
